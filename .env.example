# === Majburiy ===
# BotFather bergan token. Bu faylni .env deb nusxalab, tokenni SHU YERGA yozing.
# .env fayli git'ga tushmaydi (.gitignore da).
BOT_TOKEN=123456:AAAA-BBBB-token-shu-yerga

# Do'kon egasining Telegram user ID si.
# Shu ID li foydalanuvchi botni ochganda admin panel chiqadi (buyurtmalar, katalog,
# hisobot, sozlamalar). Bilmasangiz: botga /id yozing, bot ID ni aytadi.
ADMIN_USER_ID=

# Buyurtmalar tushadigan guruh ID si (manfiy son, masalan -1001234567890).
# Guruhga botni admin qilib qo'shing, keyin guruhda /id yozing.
# Bo'sh qoldirsangiz ham bo'ladi — u holda buyurtmalar faqat admin panelga tushadi.
ADMIN_GROUP_ID=

# === Ixtiyoriy ===
# Bo'sh bo'lsa — lokal PGlite (./data/pgdata) ishlatiladi, hech narsa o'rnatish shart emas.
# Serverga chiqqanda Neon/Supabase connection string ni shu yerga qo'ying.
DATABASE_URL=

# polling (lokal test) yoki webhook (server)
BOT_MODE=polling

# BOT_MODE=webhook bo'lganda kerak
WEBHOOK_URL=
PORT=3000

# Mini App (bot ichidagi katalog) manzili. Bo'sh bo'lsa WEBHOOK_URL ishlatiladi —
# ilova o'sha serverning o'zidan beriladi, alohida hosting kerak emas.
# Telegram faqat HTTPS ni qabul qiladi: manzil http bo'lsa mini app tugmalari
# ko'rsatilmaydi va bot eski bosqichma-bosqich oqimda ishlaydi.
WEBAPP_URL=

# Faqat lokal test uchun (`npm run dev:app`): Telegram imzosi o'rniga shu ID.
# Serverda (BOT_MODE=webhook) bu yo'l o'chiq — e'tiborga olinmaydi.
WEBAPP_DEV_USER_ID=

TZ=Asia/Tashkent
LOG_LEVEL=info
